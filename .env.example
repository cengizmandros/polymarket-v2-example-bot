# Polymarket CLOB API credentials
# Derive via: client.create_or_derive_api_creds() once you have a wallet
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Your Polygon wallet (the funder)
POLY_FUNDER=
POLY_PRIVATE_KEY=

# CLOB host (staging for pre-April-22 testing, or production)
# Staging: https://clob-v2.polymarket.com
# Production: https://clob.polymarket.com
CLOB_HOST=https://clob-v2.polymarket.com

# Optional Polygon RPC (for pUSD collateral wrap)
POLYGON_RPC=https://polygon-rpc.com

# Optional: a builderCode from your Builder Profile (bytes32)
BUILDER_CODE=
